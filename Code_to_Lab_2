def bubble_sort(b):
	sorted = False
	while sorted == False:
		count_of_correcting = 0
		for i in range (len(b)-1):
			if b[i] >b[i+1]:
				b[i], b[i+1] = b[i+1], b[i]
				count_of_correcting +=1
		if count_of_correcting == 0:
			sorted = True 
	return b
		
